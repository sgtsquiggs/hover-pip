{
  "manifest_version": 3,
  "name": "Hover PiP",
  "version": "0.1.0",
  "minimum_chrome_version": "153",
  "description": "A Picture-in-Picture button on hovered videos, ported from Firefox's toggle.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-pip": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Toggle Picture-in-Picture"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["logic.js", "toggle-styles.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
